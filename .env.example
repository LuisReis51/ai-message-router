# =============================================================================
# AI Message Router - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
# Only enable the providers you want to use.

# --- OpenAI (ChatGPT) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Google (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- xAI (Grok) ---
GROK_API_KEY=
GROK_MODEL=grok-2
GROK_BASE_URL=https://api.x.ai/v1

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Ollama (Local LLMs) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Windsurf Integration ---
# The Windsurf extension listens on this port for incoming results.
WINDSURF_HOST=localhost
WINDSURF_PORT=3000

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Router Defaults ---
# Timeout in seconds for each provider
PROVIDER_TIMEOUT=60
# Max concurrent provider calls
MAX_CONCURRENCY=6
